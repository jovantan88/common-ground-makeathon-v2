# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
# Fast model that streams fun facts while the main model works
OPENAI_FAST_MODEL=gpt-6-luna
# The art director (second AI) that plans every panel for the illustrator
OPENAI_ART_MODEL=gpt-6-astra
# low | medium | high — medium letters whole comic pages cleanly in ~20s
OPENAI_IMAGE_QUALITY=medium

# Neon Postgres connection string (https://console.neon.tech → Connect).
# Optional for local dev: without it, sagas live in server memory and vanish on restart.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
